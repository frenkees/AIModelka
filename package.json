  },
  "homepage": "https://github.com/frenkees/AIModelka#readme",
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
