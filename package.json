{
  "name": "bezmodelky",
  "version": "1.0.0",
  "description": "Web BezModelky.cz – AI fotky oblečení na modelce",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o dist/styles.css --minify",
    "build": "node scripts/build.mjs && npm run build:css && npm run build:js",
    "dev": "node scripts/build.mjs && tailwindcss -i src/input.css -o dist/styles.css --watch",
    "images": "node scripts/optimize-images.mjs",
    "images:clean": "node scripts/strip-metadata.mjs",
    "images:og": "node scripts/og-images.mjs && node scripts/strip-metadata.mjs og-image.jpg og-image-en.jpg og-image-sk.jpg og-image-de.jpg og-image-zh.jpg",
    "build:js": "esbuild src/upload.js src/karusel.js --bundle --splitting --format=esm --minify --target=es2020 --outdir=dist/assets/js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frenkees/AIModelka.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/frenkees/AIModelka/issues"
  },
  "homepage": "https://github.com/frenkees/AIModelka#readme",
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2"
  }
}
